<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- CounterStrikeSharp API -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.*" />

    <!-- CS2MenuManager - Reference from submodule or server installation -->
    <Reference Include="CS2MenuManager">
      <HintPath>..\dependencies\CS2MenuManager\CS2MenuManager\bin\Release\net8.0\CS2MenuManager.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Build CS2MenuManager from submodule if needed -->
    <ProjectReference Include="..\dependencies\CS2MenuManager\CS2MenuManager\CS2MenuManager.csproj">
      <Private>false</Private>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>

</Project>
